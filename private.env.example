# Private deployment settings (docker-compose.private.yml). Copy to .env.private (gitignored) and fill in.
# .env.private is gitignored: it holds secrets. Never commit it.

# ── Database: the dev login, the SAME values as .env (admin scripts; same db container) ──
POSTGRES_USER=swave
POSTGRES_PASSWORD=
POSTGRES_DB=swave
# The private API's own role + database (swave_private); generated by scripts/private-db-setup.ps1
PRIVATE_DB_PASSWORD=

# ── Your domain, e.g. https://swave.example.com (no trailing slash) ──
WEB_ORIGINS=

# ── Spotify (same app as development; add this redirect URI in the Spotify dashboard) ──
SPOTIFY_CLIENT_ID=
# https://<your domain>/api/auth/callback
SPOTIFY_REDIRECT_URI=

# ── Cloudflare ──
# Zero Trust → Networks → Tunnels → your tunnel → the token in the install command
CLOUDFLARE_TUNNEL_TOKEN=
# Zero Trust → Settings → Custom pages / your team name: <team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Zero Trust → Access → Applications → Swave → Overview → Application Audience (AUD) Tag
CF_ACCESS_AUD=

# ── Backups (scripts/backup.ps1): a folder that leaves this PC, outside the repo ──
# e.g. C:\Users\<you>\OneDrive\SwaveBackups (OneDrive syncs it to the cloud)
SWAVE_BACKUP_DIR=
# 1 = also back up Spotify logins (refresh tokens). Default: left out; people reconnect after a restore.
SWAVE_BACKUP_TOKENS=

# Your first name, shown to friends Spotify refuses: "Ask <name> to add your Spotify account"
SWAVE_OWNER_NAME=

# ── Optional ──
# SWAVE_PREVIEW_SOURCES=deezer,itunes
