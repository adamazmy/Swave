# Copy to .env and fill in. Never commit .env.

# ── Postgres (docker compose) ──
POSTGRES_USER=swave
POSTGRES_PASSWORD=
POSTGRES_DB=swave
POSTGRES_PORT=5432
# e.g. postgresql://swave:<password>@127.0.0.1:5432/swave
DATABASE_URL=

# ── Dataset ──
# Folder with mpd.slice.*.json files, or the path to spotify_million_playlist_dataset.zip
MPD_PATH=data/raw

# ── Spotify (dev mode app, Authorization Code + PKCE: no client secret needed) ──
SPOTIFY_CLIENT_ID=
# Must be a loopback IP (Spotify rejects "localhost"), and registered in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# ── Web ──
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
